page{min-height:100%;background:#f1f4f5;color:#142d3a;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Helvetica Neue",Arial,sans-serif}view,text,button,input,picker{box-sizing:border-box}button::after{border:none}.brand-lockup{display:flex;align-items:center;gap:16rpx}.brand-symbol{position:relative;width:42rpx;height:42rpx;border:1rpx solid currentColor;border-radius:50%}.brand-symbol:before,.brand-symbol:after{content:"";position:absolute;background:currentColor}.brand-symbol:before{left:11rpx;top:11rpx;width:18rpx;height:2rpx;box-shadow:0 7rpx 0 currentColor,0 14rpx 0 currentColor}.brand-symbol:after{left:19rpx;top:8rpx;width:2rpx;height:24rpx}.brand-name{font-size:24rpx;font-weight:700;letter-spacing:3rpx}.brand-edition{margin-top:5rpx;font-size:15rpx;letter-spacing:2rpx;opacity:.56}.eyebrow{font-size:18rpx;font-weight:700;letter-spacing:3rpx}.primary-button,.secondary-button{height:92rpx;border-radius:8rpx;font-size:26rpx;line-height:92rpx;font-weight:700}.primary-button{background:#0d5362;color:#fff;box-shadow:0 12rpx 28rpx rgba(13,83,98,.14)}.secondary-button{background:transparent;color:#0d5362;border:1rpx solid #bdced2}.field{margin-bottom:30rpx}.field-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:14rpx}.field-label{font-size:25rpx;font-weight:700;color:#243f4b}.required,.optional{font-size:18rpx;font-weight:500;color:#65808a}.field-input,.field-picker{width:100%;min-height:90rpx;padding:23rpx 0;border-bottom:1rpx solid #c8d4d7;background:transparent;font-size:29rpx;color:#142d3a}.field-input:focus,.field-picker:focus{border-color:#0d7580}.field-tip,.subject-help{margin-top:10rpx;font-size:21rpx;line-height:1.7;color:#6b8088}.segmented{display:flex;padding:6rpx;background:#e4eaeb;border-radius:10rpx}.segment{flex:1;padding:20rpx 10rpx;border-radius:7rpx;text-align:center;font-size:24rpx;color:#647b83}.segment.active{background:#fff;color:#0d5b68;font-weight:700;box-shadow:0 3rpx 12rpx rgba(24,59,67,.08)}.two-col-field{display:flex;gap:28rpx}.half-field{flex:1;min-width:0}.subject-grid{display:flex;flex-wrap:wrap;gap:12rpx;margin-top:18rpx}.subject-chip{flex:0 0 calc((100% - 24rpx)/3);padding:22rpx 8rpx;text-align:center;border:1rpx solid #d1dcde;border-radius:8rpx;color:#5f747d;font-size:24rpx}.subject-chip.active{border-color:#0d7580;background:#0d5b68;color:#fff}.subject-summary{margin-top:16rpx;font-size:21rpx;color:#6b8088}.subject-summary.ready{color:#0d6570}.profile-control{margin-top:24rpx}.mock-score-label{display:block;margin-bottom:12rpx;font-size:22rpx;color:#536d77}.mock-score-row{display:flex;gap:20rpx}.mock-score-item{flex:1}.cta-area{margin-top:34rpx}.search-results{margin-top:10rpx;padding:0 20rpx;background:#fff;border:1rpx solid #d5dfe1;border-radius:8rpx}.search-item{padding:20rpx 0;border-bottom:1rpx solid #e5ebec}.search-item:last-child{border:0}.search-item-top{display:flex;justify-content:space-between}.search-item-name{font-size:25rpx;font-weight:700}.search-item-score{font-size:19rpx;color:#0d7580}.search-item-meta,.selected-school-meta{margin-top:7rpx;font-size:19rpx;line-height:1.5;color:#70858c}.selected-school{margin:18rpx 0 24rpx;padding:20rpx;border-left:3rpx solid #0d7580;background:#e6eff0}.selected-school-mark{font-size:18rpx;color:#0d7580}.selected-school-title{margin-top:7rpx;font-size:25rpx;font-weight:700}.planning-note{margin:10rpx 0 28rpx;padding:24rpx;background:#e6edef;border-left:3rpx solid #0d7580;font-size:21rpx;line-height:1.75;color:#5d747c}.planning-note-title{margin-bottom:6rpx;color:#0d5b68;font-weight:700}.empty-state{padding:100rpx 36rpx;text-align:center}.empty-title{font-size:34rpx;font-weight:700}.empty-copy{margin:16rpx 0 30rpx;font-size:24rpx;line-height:1.7;color:#6b8088}
