page {
  min-height: 100%;
  background:
    radial-gradient(circle at top right, rgba(198, 88, 43, 0.14), transparent 28%),
    linear-gradient(180deg, #f6f0e5 0%, #efe5d5 46%, #f7f2ea 100%);
  color: #1f1a17;
  font-family: "Times New Roman", "Noto Serif SC", serif;
}

view,
text,
button,
input,
picker {
  box-sizing: border-box;
}

.page-shell {
  padding: 28rpx 28rpx 48rpx;
}

.eyebrow {
  display: inline-block;
  padding: 10rpx 18rpx;
  border: 1rpx solid rgba(77, 54, 37, 0.2);
  border-radius: 999rpx;
  font-size: 22rpx;
  letter-spacing: 2rpx;
  color: #6f5846;
  background: rgba(255, 250, 244, 0.72);
}

.hero {
  padding: 26rpx 6rpx 34rpx;
}

.hero-title {
  margin-top: 18rpx;
  font-size: 62rpx;
  line-height: 1.12;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.hero-lead {
  margin-top: 18rpx;
  max-width: 620rpx;
  font-size: 28rpx;
  line-height: 1.7;
  color: #5b4b40;
}

.hero-note {
  margin-top: 20rpx;
  font-size: 24rpx;
  color: #8c6f5b;
}

.form-block {
  padding: 32rpx 28rpx;
  border-radius: 28rpx;
  background: rgba(255, 251, 245, 0.82);
  border: 1rpx solid rgba(90, 68, 49, 0.1);
  box-shadow: 0 24rpx 60rpx rgba(117, 88, 56, 0.08);
  backdrop-filter: blur(10rpx);
}

.section-title {
  font-size: 34rpx;
  font-weight: 600;
}

.section-subtitle {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #6c584a;
}

.field-list {
  margin-top: 28rpx;
}

.field {
  margin-bottom: 22rpx;
}

.field-label {
  display: block;
  margin-bottom: 12rpx;
  font-size: 24rpx;
  color: #5f4d40;
}

.required {
  margin-left: 8rpx;
  color: #b54d2b;
}

.field-input,
.field-picker {
  width: 100%;
  min-height: 88rpx;
  padding: 24rpx 22rpx;
  border-radius: 20rpx;
  border: 1rpx solid rgba(86, 63, 45, 0.12);
  background: rgba(255, 255, 255, 0.86);
  font-size: 28rpx;
  color: #1f1a17;
}

.field-picker.placeholder,
.field-input.placeholder {
  color: #9f8a7b;
}

.search-box {
  position: relative;
}

.search-results {
  margin-top: 14rpx;
  overflow: hidden;
  border-radius: 24rpx;
  border: 1rpx solid rgba(86, 63, 45, 0.12);
  background: rgba(255, 252, 247, 0.96);
}

.search-item {
  padding: 24rpx 22rpx;
  border-bottom: 1rpx solid rgba(86, 63, 45, 0.08);
}

.search-item:last-child {
  border-bottom: none;
}

.search-item-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 24rpx;
}

.search-item-name {
  font-size: 28rpx;
  font-weight: 600;
}

.search-item-score {
  font-size: 22rpx;
  color: #9a7d66;
}

.search-item-meta {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #6f5c4e;
  line-height: 1.5;
}

.selected-school {
  margin-top: 18rpx;
  padding: 22rpx;
  border-radius: 22rpx;
  background: linear-gradient(135deg, rgba(204, 118, 67, 0.14), rgba(99, 67, 43, 0.06));
  border: 1rpx solid rgba(166, 92, 47, 0.14);
}

.selected-school-title {
  font-size: 26rpx;
  font-weight: 600;
}

.selected-school-meta {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #6e5848;
}

.field-tip {
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #8d6e5c;
}

.segmented {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 12rpx;
}


.segment {
  padding: 22rpx 16rpx;
  border-radius: 18rpx;
  border: 1rpx solid rgba(86, 63, 45, 0.1);
  background: rgba(255, 255, 255, 0.8);
  text-align: center;
  font-size: 24rpx;
  color: #5b4b40;
}

.segment.active {
  background: #ab4f2a;
  color: #fffaf4;
  border-color: #ab4f2a;
}

.cta-area {
  margin-top: 18rpx;
}

.primary-button {
  width: 100%;
  height: 92rpx;
  border-radius: 22rpx;
  background: linear-gradient(135deg, #ba5831, #8d3f22);
  color: #fff8f1;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 92rpx;
  box-shadow: 0 18rpx 34rpx rgba(141, 63, 34, 0.22);
}

.info-panel {
  margin-top: 28rpx;
  padding: 28rpx 24rpx;
  border-radius: 24rpx;
  background: rgba(83, 57, 39, 0.06);
  border: 1rpx dashed rgba(83, 57, 39, 0.16);
}

.info-title {
  font-size: 28rpx;
  font-weight: 600;
}

.info-copy {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #5f4f43;
}

.result-block {
  margin-top: 26rpx;
  padding: 28rpx 24rpx;
  border-radius: 24rpx;
  background: rgba(255, 252, 247, 0.92);
  border: 1rpx solid rgba(86, 63, 45, 0.1);
}

.result-title {
  font-size: 30rpx;
  font-weight: 600;
}

.result-row {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  margin-top: 18rpx;
  font-size: 24rpx;
  color: #54463b;
}

.result-key {
  color: #8b7260;
}

.result-value {
  text-align: right;
  color: #201912;
}

@media (max-width: 480px) {
  .hero-title {
    font-size: 52rpx;
  }
}

.mock-score-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
}

.mock-score-item {
  min-width: 0;
}

.mock-score-label {
  display: block;
  margin-bottom: 10rpx;
  font-size: 22rpx;
  color: #7a6252;
}
