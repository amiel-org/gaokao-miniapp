<view class="result-page-shell">
  <view wx:if="{{!hasResult}}" class="empty-state">
    <view class="empty-title">还没有定位结果</view>
    <view class="empty-copy">请先完成学校和校排填写，再查看适合的学校范围。</view>
    <button class="secondary-button" bindtap="handleBackEntry">返回填写</button>
  </view>

  <block wx:if="{{hasResult}}">
    <view class="result-hero gold-result-hero">
      <image class="hero-art" src="/assets/hero/hero-gold-result.jpg" mode="aspectFill"></image>
      <view class="hero-content">
        <view class="gold-result-label">定位结果</view>
        <view class="result-school">{{positionHeadline}}</view>
        <view class="result-summary">北京市位次参考已生成，金榜有位，步步登高</view>
        <view class="result-disclaimer">先看清位置，再确定专业方向与院校梯度。</view>
      </view>
    </view>

    <view class="rank-plate">
      <view class="plate-label">位次参考区间</view>
      <view class="rank-range">{{rangeDisplay}}</view>
      <view class="plate-meta">{{basisMeta}}</view>
    </view>

    <view class="insight-section">
      <view class="insight-title">定位解读</view>
      <view class="insight-copy">{{payload.result.bandText}}</view>
      <view class="metric-grid">
        <view wx:if="{{payload.input.schoolPercentile}}" class="metric-item">
          <text class="metric-label">校内百分位</text>
          <text class="metric-value">前 {{payload.input.schoolPercentile}}%</text>
        </view>
        <view class="metric-item">
          <text class="metric-label">置信度</text>
          <text class="metric-value confidence {{confidenceTone}}">{{payload.result.confidence}}</text>
        </view>
        <view wx:if="{{payload.result.parameterSnapshot.tierName}}" class="metric-item">
          <text class="metric-label">参数梯队</text>
          <text class="metric-value">{{payload.result.parameterSnapshot.tierName || '-'}}</text>
        </view>
        <view wx:else class="metric-item">
          <text class="metric-label">位次来源</text>
          <text class="metric-value">{{payload.result.positionSourceLabel}}</text>
        </view>
      </view>
    </view>

    <view wx:if="{{payload.result.warnings.length > 0}}" class="notice-section">
      <view class="notice-title">口径校准</view>
      <view wx:for="{{payload.result.warnings}}" wx:key="*this" class="notice-item">{{item}}</view>
    </view>

    <view class="detail-section">
      <view class="detail-title">定位依据</view>
      <view class="detail-row"><text class="detail-key">场景</text><text class="detail-value">{{payload.input.scoreModeLabel || '已出分填报'}}</text></view>
      <view class="detail-row"><text class="detail-key">定位方式</text><text class="detail-value">{{payload.result.positionSourceLabel}}</text></view>
      <view wx:if="{{payload.input.knownCityRank}}" class="detail-row"><text class="detail-key">官方位次</text><text class="detail-value">{{payload.input.knownCityRank}}</text></view>
      <view wx:if="{{payload.input.schoolName}}" class="detail-row"><text class="detail-key">学校</text><text class="detail-value">{{payload.input.schoolName}}</text></view>
      <view wx:if="{{payload.input.gradeRank && payload.input.gradeTotal}}" class="detail-row"><text class="detail-key">校排</text><text class="detail-value">第 {{payload.input.gradeRank}} / {{payload.input.gradeTotal}} 名</text></view>
      <view class="detail-row"><text class="detail-key">参考成绩</text><text class="detail-value">{{payload.input.scoreDisplayText || '未填写'}}</text></view>
      <view class="detail-row"><text class="detail-key">选科</text><text class="detail-value">{{payload.input.subjectCombination.label}}</text></view>
      <view wx:if="{{payload.input.studentProfileLabel}}" class="detail-row"><text class="detail-key">限制条件</text><text class="detail-value">{{payload.input.studentProfileLabel}}</text></view>
      <view wx:if="{{payload.input.rankingBasisLabel && payload.input.gradeRank}}" class="detail-row"><text class="detail-key">校排口径</text><text class="detail-value">{{payload.input.rankingBasisLabel}}</text></view>
      <view class="detail-row"><text class="detail-key">数据年份</text><text class="detail-value">位次 {{payload.result.dataYear || '-'}}｜录取参考 2025｜招生专业 2026</text></view>
    </view>

    <view class="next-section">
      <view class="next-title">下一步</view>
      <view wx:for="{{nextSteps}}" wx:key="*this" class="next-item"><text class="next-dot"></text><text>{{item}}</text></view>
    </view>

    <view class="result-actions">
      <button class="secondary-button" bindtap="handleBackEntry">返回修改</button>
      <button class="primary-button compact" bindtap="handleNextVolunteer">选择专业方向</button>
    </view>
  </block>
</view>

