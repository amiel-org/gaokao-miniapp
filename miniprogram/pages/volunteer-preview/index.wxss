page {
  min-height: 100%;
  background:
    radial-gradient(circle at top right, rgba(198, 88, 43, 0.14), transparent 28%),
    linear-gradient(180deg, #f6f0e5 0%, #efe5d5 46%, #f7f2ea 100%);
  color: #1f1a17;
  font-family: "Times New Roman", "Noto Serif SC", serif;
}

.volunteer-shell {
  padding: 30rpx 28rpx 52rpx;
}

.volunteer-hero {
  padding: 22rpx 4rpx 30rpx;
}

.volunteer-title {
  margin-top: 18rpx;
  font-size: 52rpx;
  line-height: 1.12;
  font-weight: 600;
}

.volunteer-copy {
  margin-top: 16rpx;
  font-size: 25rpx;
  line-height: 1.7;
  color: #5f4d40;
}

.base-panel,
.notice-panel,
.empty-state {
  padding: 28rpx 24rpx;
  border-radius: 26rpx;
  background: rgba(255, 252, 247, 0.9);
  border: 1rpx solid rgba(86, 63, 45, 0.1);
}

.base-label {
  font-size: 24rpx;
  color: #8b7260;
}

.base-range {
  margin-top: 10rpx;
  font-size: 48rpx;
  font-weight: 700;
}

.base-meta {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #6f5c4e;
}

.group-list {
  margin-top: 24rpx;
}

.group-item {
  display: flex;
  gap: 18rpx;
  padding: 26rpx 22rpx;
  margin-bottom: 18rpx;
  border-radius: 26rpx;
  background: rgba(255, 252, 247, 0.92);
  border: 1rpx solid rgba(86, 63, 45, 0.1);
}

.group-mark {
  flex: 0 0 auto;
  width: 58rpx;
  height: 58rpx;
  border-radius: 50%;
  background: #ab4f2a;
  color: #fff8f1;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 58rpx;
  text-align: center;
}

.group-title {
  font-size: 30rpx;
  font-weight: 600;
}

.group-range {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #201912;
}

.group-desc,
.notice-copy,
.empty-copy {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #5f4f43;
}

.notice-title,
.empty-title {
  font-size: 30rpx;
  font-weight: 600;
}

.primary-button.compact,
.secondary-button {
  margin-top: 26rpx;
  height: 88rpx;
  border-radius: 22rpx;
  font-size: 28rpx;
  line-height: 88rpx;
  font-weight: 600;
}

.primary-button.compact {
  background: linear-gradient(135deg, #ba5831, #8d3f22);
  color: #fff8f1;
}

.secondary-button {
  color: #5f4d40;
  background: rgba(255, 252, 247, 0.9);
  border: 1rpx solid rgba(86, 63, 45, 0.14);
}
