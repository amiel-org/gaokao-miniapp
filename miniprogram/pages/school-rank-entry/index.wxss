.page-shell{background:#f1f4f5}.entry-cover{position:relative;height:830rpx;overflow:hidden;padding:42rpx 42rpx 0;background:#092f3b;color:#edf5f3}.entry-cover:after{content:"";position:absolute;left:0;right:0;bottom:0;height:1rpx;background:rgba(255,255,255,.14)}.cover-nav{position:relative;z-index:3;display:flex;justify-content:space-between;align-items:center}.cover-nav-mark{display:flex;align-items:center;justify-content:center;width:48rpx;height:48rpx;border:1rpx solid rgba(231,244,239,.3);font-size:22rpx}.cover-main{position:relative;z-index:3;margin-top:82rpx}.cover-eyebrow{font-size:20rpx;letter-spacing:4rpx;color:#8dc2be}.cover-title{margin-top:24rpx;font-size:72rpx;line-height:1.2;font-weight:700;letter-spacing:3rpx}.cover-copy{margin-top:24rpx;font-size:23rpx;line-height:1.8;color:#a9c5c7}.coordinate-art{position:absolute;right:-118rpx;top:336rpx;width:510rpx;height:510rpx;opacity:.9}.orbit{position:absolute;border:1rpx solid rgba(121,187,180,.25);border-radius:50%}.orbit-one{inset:0}.orbit-two{inset:65rpx}.orbit-three{inset:130rpx}.axis{position:absolute;background:rgba(121,187,180,.2)}.axis-x{left:0;right:0;top:50%;height:1rpx}.axis-y{top:0;bottom:0;left:50%;width:1rpx}.coordinate-center{position:absolute;left:192rpx;top:190rpx;width:126rpx;height:126rpx;display:flex;flex-direction:column;align-items:center;justify-content:center;border:1rpx solid rgba(162,211,201,.55);border-radius:50%;background:#0d4651;box-shadow:0 0 0 16rpx rgba(58,117,119,.14)}.coordinate-center text{font-size:18rpx;line-height:1.55;letter-spacing:4rpx;color:#c6e4dd}.coordinate-dot{position:absolute;width:12rpx;height:12rpx;border-radius:50%;background:#9accc0;box-shadow:0 0 0 8rpx rgba(151,207,191,.12)}.dot-one{left:100rpx;top:126rpx}.dot-two{left:294rpx;top:62rpx}.dot-three{left:327rpx;top:338rpx}.cover-foot{position:absolute;z-index:3;left:42rpx;right:42rpx;bottom:38rpx;display:flex;padding-top:28rpx;border-top:1rpx solid rgba(220,239,235,.2)}.cover-foot>view{flex:1;display:flex;flex-direction:column}.cover-foot text:first-child{font-size:38rpx;font-weight:300;letter-spacing:1rpx}.cover-foot text:last-child{margin-top:8rpx;font-size:18rpx;color:#8eb2b5}.scope-line{display:flex;justify-content:space-between;padding:26rpx 38rpx;background:#e4ecec;color:#4b6a73;font-size:19rpx}.entry-workspace{padding:46rpx 38rpx 24rpx;background:#f7f8f7}.workspace-caption{display:flex;gap:20rpx;align-items:center;margin-bottom:30rpx;font-size:18rpx;letter-spacing:2rpx;color:#668088}.workspace-caption text:first-child{font-size:28rpx;color:#0d7580}.section-title{font-size:40rpx;line-height:1.3;font-weight:700;color:#173844}.section-subtitle{margin:12rpx 0 36rpx;font-size:22rpx;line-height:1.7;color:#6b8088}.entry-method{padding:46rpx 38rpx 64rpx;background:#e7eeee}.method-index{font-size:16rpx;letter-spacing:3rpx;color:#0d7580}.info-title{margin-top:20rpx;font-size:30rpx;line-height:1.5;font-weight:700;color:#173844}.info-copy{margin-top:16rpx;font-size:22rpx;line-height:1.8;color:#5c747c}

.cover-title text,.cover-copy text{display:block}.cover-title{font-size:68rpx}
